# Пример окружения mdcloud. deploy.sh создаёт настоящий .env сам
# (права 600, пароль и соль генерируются) — этот файл для ручной установки.
#
# Секреты в репозиторий не попадают: .env в .gitignore.

MDCLOUD_ADDR=127.0.0.1:8080
MDCLOUD_DATABASE_URL=postgres://mdcloud:пароль@localhost:5432/mdcloud?sslmode=disable

# Публичные адреса: облако и редактор mathmd.
MDCLOUD_BASE_URL=https://mdcloud.example
MDCLOUD_EDITOR_URL=https://mathmd.example

# Кому разрешён CORS к /api (оба сайта через запятую).
MDCLOUD_ALLOWED_ORIGINS=https://mdcloud.example,https://mathmd.example

# Первый пользователь заводится всегда; false закрывает регистрацию дальше.
MDCLOUD_ALLOW_REGISTRATION=false

# Соль для хеширования IP комментаторов. Сгенерировать:
#   openssl rand -hex 24
MDCLOUD_IP_SALT=замени-меня

MDCLOUD_SESSION_TTL=720h
MDCLOUD_HANDOFF_TTL=90s
MDCLOUD_COMMENT_LIMIT=10
MDCLOUD_COMMENT_WINDOW=10m
MDCLOUD_MAX_DOC_BYTES=2097152

# mdcloud — блок для Caddyfile. deploy.sh добавляет такой блок сам и
# проверяет конфиг через `caddy validate` перед перезагрузкой.
#
# Статика лежит отдельно от репозитория: caddy не имеет доступа в /home/*,
# поэтому web/ копируется в /var/www/html/mdcloud.
#
# Подставь свой домен, адрес редактора и порт сервиса.

mdcloud.example {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		# Запрет на выполнение держит эта строка, а не чистка HTML: скрипты
		# только свои и с cdn.jsdelivr.net (showdown, chessjax, MathJax), ни
		# 'unsafe-inline', ни 'unsafe-eval' — поэтому тег из документа не
		# исполнится, а форма не отправится на чужой адрес (form-action).
		#
		# style-src с 'unsafe-inline' — плата за MathJax и chessjax: оба
		# собирают свою таблицу стилей прямо в документе. Вставший <style>
		# так можно, но скриптом это не становится.
		#
		# Рамки: /embed/desmos — тот же сайт, поэтому frame-src 'self'.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'; frame-src 'self'; form-action 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}

	# API — на сервис, всё остальное — статика предпросмотра.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# График Desmos живёт отдельным документом, и политика у него своя — узкая
	# по составу, но с 'unsafe-eval': SDK Desmos исполняет строки как код и без
	# него не поднимается. На страницу документа такое разрешение пускать
	# нельзя — она рисует чужой markdown, и её защита держится ровно на том,
	# что исполнить вставленный тег нечем. Здесь же, кроме графика, нет ничего:
	# выражения приходят во фрагменте адреса и уходят в калькулятор строками.
	#
	# frame-ancestors 'self' — рамку показывает только страница облака.
	handle /embed/desmos* {
		root * /var/www/html/mdcloud
		header Content-Security-Policy "default-src 'none'; script-src 'self' https://www.desmos.com 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://www.desmos.com; img-src 'self' data: blob: https://www.desmos.com; font-src 'self' data: blob: https://www.desmos.com; media-src 'self' data: blob: https://www.desmos.com; connect-src https://www.desmos.com; frame-src https://www.desmos.com; worker-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		rewrite * /embed-desmos.html
		file_server
	}

	handle {
		root * /var/www/html/mdcloud
		# Статика не должна залипать в браузере: страница облака живёт одной
		# вкладкой неделями, и старая копия скрипта молча ломает свежие правки.
		# no-cache (не no-store) оставляет копию, но обязывает спросить сервер —
		# Caddy отвечает 304, пока файл не менялся. «/» здесь тоже: try_files
		# отдаёт по нему index.html, и без явного совпадения корень остался бы
		# без заголовка.
		@nocache path / *.js *.mjs *.html *.css
		header @nocache Cache-Control "no-cache"
		# Адреса документов разбирает браузер: /имя/папка/файл отдаёт ту же
		# страницу, а не 404.
		try_files {path} /index.html
		file_server
	}
}

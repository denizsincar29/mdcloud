# mdcloud — блок для Caddyfile. deploy.sh добавляет такой блок сам и
# проверяет конфиг через `caddy validate` перед перезагрузкой.
#
# Статика лежит отдельно от репозитория: caddy не имеет доступа в /home/*,
# поэтому web/ копируется в /var/www/html/mdcloud.
#
# Подставь свой домен, адрес редактора и порт сервиса.

mdcloud.example {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		# Запрет на выполнение держит эта строка, а не чистка HTML: скрипты
		# только свои и с cdn.jsdelivr.net (showdown, chessjax, MathJax), ни
		# 'unsafe-inline', ни 'unsafe-eval' — поэтому тег из документа не
		# исполнится, а форма не отправится на чужой адрес (form-action).
		#
		# style-src с 'unsafe-inline' — плата за MathJax и chessjax: оба
		# собирают свою таблицу стилей прямо в документе. Вставший <style>
		# так можно, но скриптом это не становится.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'; form-action 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}

	# API — на сервис, всё остальное — статика предпросмотра.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /var/www/html/mdcloud
		# Статика не должна залипать в браузере: страница облака живёт одной
		# вкладкой неделями, и старая копия скрипта молча ломает свежие правки.
		# no-cache (не no-store) оставляет копию, но обязывает спросить сервер —
		# Caddy отвечает 304, пока файл не менялся. «/» здесь тоже: try_files
		# отдаёт по нему index.html, и без явного совпадения корень остался бы
		# без заголовка.
		@nocache path / *.js *.mjs *.html *.css
		header @nocache Cache-Control "no-cache"
		# Адреса документов разбирает браузер: /имя/папка/файл отдаёт ту же
		# страницу, а не 404.
		try_files {path} /index.html
		file_server
	}
}
